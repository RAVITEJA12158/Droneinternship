DATABASE_URL=postgresql://user:pass@localhost:5432/dronevault
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRY=7d
COOKIE_SECRET=your_cookie_secret_change_in_production
STORAGE_ROOT=/absolute/path/to/DroneVault/storage
PYTHON_BIN=python
DISEASE_MODEL_CHECKPOINT=/absolute/path/to/model_checkpoint.pth
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development
LOG_DATABASE_QUERIES=false
